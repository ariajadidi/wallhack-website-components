<div class="wh-callout{% if block.settings.type == 'empty' %} wh-callout--empty{% endif %}" data-wh-block="{{ block.id }}" {{ block.shopify_attributes }}>
  {%- if block.settings.type != 'empty' -%}
    <span class="wh-callout__line"></span>
    <div class="wh-callout__text wh-p2">{{ block.settings.text }}</div>
  {%- endif -%}
</div>
