<section class="wh-section{% if section.settings.spacing == 'regular' %} wh-spacing-regular{% endif %} wh-cards wh-scheme-{{ section.settings.color_scheme }}" style="{% render 'wh-colors', s: section.settings %}">
  {%- if section.settings.show_heading or section.settings.show_intro -%}
  <div class="wh-cards__text">
    {%- if section.settings.show_heading -%}<h2 class="wh-h1">{{ section.settings.heading | escape | newline_to_br }}</h2>{%- endif -%}
    {%- if section.settings.show_intro -%}
      <div class="wh-cards__intro"><div class="wh-p1">{{ section.settings.intro_1 }}</div><div class="wh-p1">{{ section.settings.intro_2 }}</div></div>
    {%- endif -%}
  </div>
  {%- endif -%}
  <div class="wh-cards__cards">{% content_for 'blocks' %}</div>
</section>

{% schema %}
{
  "name": "WH Cards",
  "blocks": [
    {
      "type": "wh-card"
    }
  ],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_heading",
      "label": "Show heading",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wallhack KS-TR linear switch series"
    },
    {
      "type": "checkbox",
      "id": "show_intro",
      "label": "Show intro",
      "default": true
    },
    {
      "type": "richtext",
      "id": "intro_1",
      "label": "Intro column 1",
      "default": "<p>Text</p>"
    },
    {
      "type": "richtext",
      "id": "intro_2",
      "label": "Intro column 2",
      "default": "<p>Text</p>"
    },
    {
      "type": "select",
      "id": "spacing",
      "label": "Spacing",
      "default": "large",
      "info": "Space above and below the section. Figma: section padding linked to layout/block-padding-y = Regular.",
      "options": [
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "regular",
          "label": "Regular"
        }
      ]
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour mode",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "type": "header",
      "content": "Custom colours (collaboration pages)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to use the colour mode above. Filled in = this section uses these colours instead."
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "custom_foreground",
      "label": "Text + icons"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Borders"
    },
    {
      "type": "color",
      "id": "custom_image_background",
      "label": "Photo background colour",
      "info": "Behind photos (Solid). Figma: change the photo frame’s fill colour."
    }
  ],
  "presets": [
    {
      "name": "WH Cards",
      "blocks": [
        {
          "type": "wh-card"
        },
        {
          "type": "wh-card"
        },
        {
          "type": "wh-card"
        }
      ]
    }
  ],
  "tag": "div"
}
{% endschema %}
