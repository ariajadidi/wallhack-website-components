<section class="wh-section wh-spec-sheet wh-scheme-{{ section.settings.color_scheme }}" style="{% render 'wh-colors', s: section.settings %}">{% content_for 'blocks' %}</section>

{% schema %}
{
  "name": "WH Spec sheet",
  "blocks": [
    {
      "type": "wh-spec-row"
    }
  ],
  "presets": [
    {
      "name": "WH Spec sheet",
      "blocks": [
        {
          "type": "wh-spec-row",
          "settings": {
            "specs": "1"
          }
        },
        {
          "type": "wh-spec-row",
          "settings": {
            "specs": "2"
          }
        }
      ]
    }
  ],
  "tag": "div",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour mode",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "type": "header",
      "content": "Custom colours (collaboration pages)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to use the colour mode above. Filled in = this section uses these colours instead."
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "custom_foreground",
      "label": "Text + icons"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Borders"
    },
    {
      "type": "color",
      "id": "custom_image_background",
      "label": "Photo background colour",
      "info": "Behind photos (Solid). Figma: change the photo frame’s fill colour."
    }
  ]
}
{% endschema %}
