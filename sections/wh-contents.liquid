<section class="wh-section wh-contents wh-scheme-{{ section.settings.color_scheme }}" style="{% render 'wh-colors', s: section.settings %}">
  <div class="wh-contents__label-top wh-h2">{{ section.settings.label | escape }}</div>
  <div class="wh-contents__row">
    <div class="wh-contents__label wh-h2">{{ section.settings.label | escape }}</div>
    <div class="wh-contents__items">{% content_for 'blocks' %}</div>
  </div>
</section>

{% schema %}
{
  "name": "WH Contents",
  "blocks": [
    {
      "type": "wh-contents-item"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "Contents"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour mode",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "type": "header",
      "content": "Custom colours (collaboration pages)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to use the colour mode above. Filled in = this section uses these colours instead."
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "custom_foreground",
      "label": "Text + icons"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Borders"
    },
    {
      "type": "color",
      "id": "custom_image_background",
      "label": "Photo background colour",
      "info": "Behind photos (Solid). Figma: change the photo frame’s fill colour."
    }
  ],
  "presets": [
    {
      "name": "WH Contents",
      "blocks": [
        {
          "type": "wh-contents-item"
        },
        {
          "type": "wh-contents-item"
        },
        {
          "type": "wh-contents-item"
        },
        {
          "type": "wh-contents-item"
        }
      ]
    }
  ],
  "tag": "div"
}
{% endschema %}
