<section class="wh-section wh-intro wh-scheme-{{ section.settings.color_scheme }}" style="{% render 'wh-colors', s: section.settings %}">
  <div class="wh-intro__text">
    <h2 class="wh-h1">{{ section.settings.heading | escape | newline_to_br }}</h2>
    <div class="wh-intro__body wh-p1 wh-mobile-left">{{ section.settings.body }}</div>
  </div>
  <div class="wh-intro__usps">
    {%- if section.blocks.size > 0 -%}<div class="wh-usp-row">{% content_for 'blocks' %}</div>{%- endif -%}
    {%- if section.settings.show_cta -%}
      <a class="wh-button wh-p1" href="{{ section.settings.cta_link | default: routes.all_products_collection_url }}">{{ section.settings.cta_label | escape }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "WH Intro + USPs",
  "blocks": [
    {
      "type": "wh-usp"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "A legacy, sharpened"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Five years after the original skypad redefined the glass mousepad, the 005 generation arrives.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_cta",
      "label": "Show button",
      "default": true
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Choose your pad"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour mode",
      "default": "light",
      "options": [
        {
          "value": "light",
          "label": "Light"
        },
        {
          "value": "dark",
          "label": "Dark"
        }
      ]
    },
    {
      "type": "header",
      "content": "Custom colours (collaboration pages)"
    },
    {
      "type": "paragraph",
      "content": "Leave empty to use the colour mode above. Filled in = this section uses these colours instead."
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Background"
    },
    {
      "type": "color",
      "id": "custom_foreground",
      "label": "Text + icons"
    },
    {
      "type": "color",
      "id": "custom_border",
      "label": "Borders"
    },
    {
      "type": "color",
      "id": "custom_image_background",
      "label": "Photo background colour",
      "info": "Behind photos (Solid). Figma: change the photo frame’s fill colour."
    }
  ],
  "presets": [
    {
      "name": "WH Intro + USPs",
      "blocks": [
        {
          "type": "wh-usp"
        },
        {
          "type": "wh-usp"
        },
        {
          "type": "wh-usp"
        },
        {
          "type": "wh-usp"
        },
        {
          "type": "wh-usp"
        }
      ]
    }
  ],
  "tag": "div"
}
{% endschema %}
