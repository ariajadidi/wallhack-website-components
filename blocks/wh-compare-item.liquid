      "id": "image_ratio",
      "label": "Custom ratio (width ÷ height)",
      "info": "Only used when Image shape is Custom."
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "SP-005"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "Show tags",
      "default": true
    },
    {
      "type": "text",
      "id": "suitable_label",
      "label": "Label above tags",
      "default": "suitable for"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Text</p>"
    }
  ],
  "presets": [
    {
      "name": "Compare column",
      "blocks": [
        {
          "type": "wh-compare-tag"
        },
        {
          "type": "wh-compare-tag"
        }
      ]
    }
  ]
}
{% endschema %}
