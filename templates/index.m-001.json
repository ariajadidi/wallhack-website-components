    "intro_usps_4": {
      "type": "wh-intro-usps",
      "settings": {
        "heading": "INTRODUCING THE M-001",
        "body": "<p>The WALLHACK M-001 is a premium wireless gaming mouse built around a die-cast magnesium alloy shell. Its wireless receiver doubles as a charging dock and control interface, and a hot-swappable battery system means the mouse never has to stop for charging.</p><p>The M-001 is available for *PRICE*</p>",
        "show_cta": true,
        "cta_label": "get notified",
        "color_scheme": "dark",
        "custom_background": "#0e0e0e"
      },
      "blocks": {},
      "block_order": []
    },
