    "cover_22": {
      "type": "wh-cover",
      "settings": {
        "heading": "Safe from prying Paws",
        "subheading": "The K-001 ships in a rugged and protective carry case that you can use to transport the K-001 as well as all the included accessories.",
        "show_subheading": true,
        "subtitle_position": "top",
        "image": "shopify://shop_images/wh-camp-a50f8d38.png",
        "image_mobile": "shopify://shop_images/wh-camp-1b5c6923.jpg",
        "image_fade": "none",
