    "intro_usps_7": {
      "type": "wh-intro-usps",
      "settings": {
        "heading": "INTRODUCING THE K-001",
        "body": "<p>The WALLHACK K-001 is a compact 65% high-performance Hall Effect (HE) keyboard built for speed, consistency, and control. It combines a precision CNC-machined aluminum enclosure with the WALLHACK CORE-MK1 electronics platform and the WALLHACK KS-TR Linear Switch (Medium), co-developed with Gateron. On-device quick settings and a stepped endless dial allow real-time adjustment of actuation point and Rapid Trigger. All wrapped in function-first Danish design.</p><p>The K-001 is available for *PRICE*</p>",
        "show_cta": true,
        "cta_label": "get notified",
        "color_scheme": "dark",
        "custom_background": "#0e0e0e"
      },
      "blocks": {},
      "block_order": []
    },
    "text_media_8": {
      "type": "wh-text-media",
      "settings": {
        "no_space_top": false,
        "no_space_bottom": false,
        "show_heading": false,
        "heading": "Spill it, wipe it, keep playing",
        "body": "<p>The K-001 is available in both Natural and Slate colour ways</p>",
        "image": "shopify://shop_images/wh-camp-0d429cb9.png",
        "image_mobile": "shopify://shop_images/wh-camp-a08aced2.png",
        "image_fade": "none",
        "image_fade_mobile": "none",
        "image_background": "none",
        "image_mobile_shape": "2:3",
        "image_fit": "fit",
        "image_fit_mobile": "same",
        "color_scheme": "dark",
