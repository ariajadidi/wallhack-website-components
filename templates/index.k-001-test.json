        "spacing": "regular",
        "image_shape": "4:3",
        "custom_background": "#0e0e0e"
      }
    },
    "split_14": {
      "type": "wh-split",
      "settings": {
        "image_side": "right",
        "heading": "Focused Light path",
        "body": "<p>Our switches have a first of its kind light guide structure that directs the light to the keycap legend and minimizes the light bleed on the switch plate.</p><p>Our custom double-shot PBT keycaps and 0.1mm precision keycap legends allows for focused light illuminating the legend with little to no light spill.</p>",
        "image": "shopify://shop_images/wh-camp-b010a730.png",
        "image_mobile": "shopify://shop_images/wh-camp-077b1da4.png",
        "image_fade": "none",
        "image_fade_mobile": "none",
        "image_background": "none",
        "image_mobile_shape": "16:9",
        "image_fit": "fit",
        "image_fit_mobile": "same",
        "color_scheme": "dark",
        "spacing": "regular",
        "image_shape": "4:3",
        "custom_background": "#0e0e0e"
      }
    },
    "text_media_15": {
      "type": "wh-text-media",
      "settings": {
        "no_space_top": true,
        "no_space_bottom": true,
        "show_heading": false,
        "heading": "Spill it, wipe it, keep playing",
        "body": "<p>The transparency of our keycap light guide allows for a stealth look by turning the brightness to 0. Giving the keycaps an almost pure black appearance.</p>",
        "image": "shopify://shop_images/wh-camp-6585c10e.png",
        "image_mobile": "shopify://shop_images/wh-camp-bd434cf1.png",
        "image_fade": "none",
