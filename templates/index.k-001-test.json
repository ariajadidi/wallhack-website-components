    "cards_12": {
      "type": "wh-cards",
      "settings": {
        "show_heading": true,
        "heading": "WAllhack ks-tr\nlinear switch series",
        "show_intro": true,
        "intro_1": "<p>Our keyboard comes with our brand new series of custom hall effect switches, the Wallhack KS-TR Linear switch. Made in collaboration with the industry leaders in keyboard switch manufacturing, Gateron.</p>",
        "intro_2": "<p>The KS-TR series features three spring weights: Light, Medium and Heavy, giving our users the option to mix and match different spring weights to achieve the perfect combination for your exact needs.</p>",
        "color_scheme": "dark",
        "spacing": "large",
        "custom_background": "#0e0e0e"
      },
      "blocks": {
        "card_1": {
          "type": "wh-card",
          "settings": {
            "name": "KS-TR Light",
            "description": "<p>Light is the fastest, lightest touch, built for quick actuation and repeated input.</p>",
            "image": "shopify://shop_images/wh-camp-538b5aed.png",
            "image_fit": "fit",
            "image_background": "solid",
            "image_shape": "4:3"
          }
        },
        "card_2": {
          "type": "wh-card",
          "settings": {
            "name": "KS-TR Medium",
            "description": "<p>Medium is slightly heavier than average, and is a nice balance between speed and control with its firm keypress feel.</p>",
            "image": "shopify://shop_images/wh-camp-bd77829c.png",
            "image_fit": "fit",
            "image_background": "solid",
            "image_shape": "4:3"
          }
        },
        "card_3": {
          "type": "wh-card",
          "settings": {
            "name": "KS-TR Heavy",
            "description": "<p>Heavy is more deliberate, giving you fewer accidental presses. A great typing feel and nice for users who enjoy a more substantial and precise keypress feel.</p>",
            "image": "shopify://shop_images/wh-camp-47391fb2.png",
            "image_fit": "fit",
            "image_background": "solid",
            "image_shape": "4:3"
          }
        }
      },
      "block_order": [
        "card_1",
        "card_2",
        "card_3"
      ]
    },
    "split_13": {
      "type": "wh-split",
      "settings": {
        "image_side": "left",
        "heading": "Tailored to your preferences",
        "body": "<p>Control your actuation point and Rapid Trigger sensitivity on directly on the keyboard using the stepped dial.</p><p>The K-001 comes stock with the KS-TR (Medium) and the Heavy and Light variants will be available separately at launch</p>",
        "image": "shopify://shop_images/wh-camp-493f4ffb.png",
        "image_mobile": "shopify://shop_images/wh-camp-47272cad.png",
        "image_fade": "none",
        "image_fade_mobile": "none",
        "image_background": "none",
        "image_mobile_shape": "16:9",
        "image_fit": "fit",
